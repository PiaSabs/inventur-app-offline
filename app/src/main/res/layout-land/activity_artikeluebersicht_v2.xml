<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/artikeluebersichtRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    tools:context=".ArtikeluebersichtV2Activity">

    <View
        android:id="@+id/artikelDarkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66081325"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/artikelContentLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/speichernButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/zurueckButtonWrapper"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_meta_panel">

                <ImageButton
                    android:id="@+id/zurueckButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/zurueck_beschreibung"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="#FFFFFF" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/screenTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/artikeluebersicht_titel"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Zählerliste Wareneingang" />

                <TextView
                    android:id="@+id/screenSubtitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/artikeluebersicht_untertitel"
                    android:textColor="#B8C6DF"
                    android:textSize="10sp"
                    tools:text="Bereich: Lager Nord" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/headerRefreshButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_meta_panel">

                <ImageButton
                    android:id="@+id/aktualisierenButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/aktualisieren_beschreibung"
                    android:padding="7dp"
                    android:src="@android:drawable/ic_popup_sync"
                    app:tint="#FFFFFF" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/headerMenuButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_meta_panel">

                <ImageButton
                    android:id="@+id/filterButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/filter_symbol_beschreibung"
                    android:padding="7dp"
                    android:src="@drawable/ic_menu"
                    app:tint="#FFFFFF" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/testmodusTextView"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_meta_panel"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/testmodus_hinweis"
                android:textColor="#D9E6FF"
                android:textSize="10sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/syncStatusContainer"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_meta_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/syncStatusTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_status_erfolgreich"
                    android:textColor="#B6F0C2"
                    android:textSize="10sp" />

                <ImageButton
                    android:id="@+id/syncStatusInfoButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/sync_status_info_beschreibung"
                    android:padding="4dp"
                    android:src="@drawable/ic_info_circle"
                    android:visibility="gone"
                    app:tint="#FFE19A" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/metaInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:cardBackgroundColor="#CC142744"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#33578FCF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stichtag_label"
                        android:textColor="#9CB0DB"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/stichtagTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="30.06.2026" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/blattnummer_label"
                        android:textColor="#9CB0DB"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/vorherigesBlattButton"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/vorheriges_blatt_beschreibung"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_media_previous"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:id="@+id/blattnummerTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="BL-014" />

                        <ImageButton
                            android:id="@+id/naechstesBlattButton"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/naechstes_blatt_beschreibung"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_media_next"
                            app:tint="#FFFFFF" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/letzte_zaehlung_label"
                        android:textColor="#9CB0DB"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/letztesZaehldatumTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/artikeluebersicht_letzte_zaehlung_standard"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="28.04.2026" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bereich_label"
                        android:textColor="#9CB0DB"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/bereichTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Lager Nord" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fortschritt_label"
                        android:textColor="#9CB0DB"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/fortschrittTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2 von 3" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/navigationsleisteCard"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_meta_panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zaehler_label"
                        android:textColor="#9CB0DB"
                        android:textSize="9sp" />

                    <EditText
                        android:id="@+id/zaehlerEditText"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginTop="1dp"
                        android:background="@android:color/transparent"
                        android:inputType="textPersonName"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B8BEDD"
                        android:textSize="14sp"
                        tools:text="Max Mustermann" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/zaehlerVertretungButton"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="7dp"
                    android:layout_marginBottom="5dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/zaehler_vertretung_beschreibung"
                    android:padding="1dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#D9E6FF" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_meta_panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schreiber_label"
                        android:textColor="#9CB0DB"
                        android:textSize="9sp" />

                    <EditText
                        android:id="@+id/schreiberEditText"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginTop="1dp"
                        android:background="@android:color/transparent"
                        android:inputType="textPersonName"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B8BEDD"
                        android:textSize="14sp"
                        tools:text="Erika Beispiel" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/schreiberVertretungButton"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="7dp"
                    android:layout_marginBottom="5dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/schreiber_vertretung_beschreibung"
                    android:padding="1dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#D9E6FF" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/listContainerLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/listSectionTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/artikel_liste_titel"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/listSectionHintTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:singleLine="true"
                    android:text="@string/artikel_liste_untertitel"
                    android:textColor="#AAB7D1"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/originalLetzteZaehlungTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_meta_panel"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/artikeluebersicht_letzte_zaehlung_standard"
                    android:textColor="#D9E6FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <EditText
                android:id="@+id/artikelSucheEditText"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_meta_panel"
                android:hint="@string/artikel_suche_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAB7D1"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/artikelTabellenkopfLayout"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_meta_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:text="@string/artikel_tabellenkopf_position"
                    android:textColor="#9CB0DB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="@string/artikel_tabellenkopf_ident"
                    android:textColor="#9CB0DB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_anmerkung"
                    android:textColor="#9CB0DB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_letzte_zaehlmenge"
                    android:textColor="#9CB0DB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_ist"
                    android:textColor="#9CB0DB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_min"
                    android:textColor="#9CB0DB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_zaehl"
                    android:textColor="#9CB0DB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/leerstandTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:text="@string/leere_artikelliste_hinweis"
                android:textColor="#D8DDF3"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/artikelRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="56dp"
                tools:itemCount="5"
                tools:listitem="@layout/item_artikel" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/speichernButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_login_primary_button"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/speichernIconImageView"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="82dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_save"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/speichernTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/autosave_status_aktiv"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
