<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inventur_demo_background"
    tools:context=".LoginActivity">

    <!-- Dunkle Ãœberlagerung fÃ¼r bessere Lesbarkeit -->
    <View
        android:id="@+id/loginDraftOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99081325"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Hauptinhalt -->
    <LinearLayout
        android:id="@+id/loginDraftContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/loginDraftFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.43">

        <!-- Logo-Kachel -->
        <FrameLayout
            android:id="@+id/loginLogoTile"
            android:layout_width="132dp"
            android:layout_height="118dp"
            android:background="@drawable/bg_login_logo_tile"
            android:elevation="12dp"
            android:padding="5dp">

            <ImageView
                android:id="@+id/loginLogoImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/inventur_demo_logo" />

        </FrameLayout>

        <!-- Abstand Logo zu Titel -->
        <Space
            android:layout_width="1dp"
            android:layout_height="74dp" />

        <!-- Titel -->
        <TextView
            android:id="@+id/loginDraftTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/login_titel"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <!-- Untertitel -->
        <TextView
            android:id="@+id/loginDraftSubtitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:lineSpacingExtra="5dp"
            android:text="@string/login_untertitel"
            android:textColor="#C4D1E6"
            android:textSize="16sp" />

        <!-- Abstand Untertitel zu Eingabe -->
        <Space
            android:layout_width="1dp"
            android:layout_height="42dp" />

        <!-- Eingabefeld -->
        <LinearLayout
            android:id="@+id/loginNameInputCard"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:background="@drawable/bg_login_input_card"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="15dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/loginInputLabelTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/login_zaehler_label"
                android:textColor="#8FA4CF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/zaehlerNameEditText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/login_beispielname"
                android:inputType="textPersonName"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#F3F7FF"
                android:textSize="22sp"
                tools:text="Max Mustermann" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_login_focus_line" />

        </LinearLayout>

        <!-- Abstand Eingabe zu Button -->
        <Space
            android:layout_width="1dp"
            android:layout_height="42dp" />

        <!-- Hauptbutton -->
        <FrameLayout
            android:id="@+id/anmeldenButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_login_primary_button"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/loginPrimaryButtonTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/login_button"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/loginPrimaryButtonArrowImageView"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right" />

        </FrameLayout>

    </LinearLayout>

    <!-- Footer unten -->
    <LinearLayout
        android:id="@+id/loginDraftFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="34dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_check"
                app:tint="#5E82D5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif"
                android:text="@string/login_fussnote_zeile_eins"
                android:textColor="#C4D1E6"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="@string/login_fussnote_zeile_zwei"
            android:textColor="#8FA4CF"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

