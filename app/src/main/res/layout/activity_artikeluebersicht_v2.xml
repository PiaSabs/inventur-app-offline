<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/artikeluebersichtRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    tools:context=".ArtikeluebersichtV2Activity">

    <!-- Dunkle Ãœberlagerung fÃ¼r bessere Lesbarkeit -->
    <View
        android:id="@+id/artikelDarkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66081325"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Hauptinhalt -->
    <LinearLayout
        android:id="@+id/artikelContentLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="34dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/speichernButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/zurueckButtonWrapper"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_meta_panel">

                <ImageButton
                    android:id="@+id/zurueckButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/zurueck_beschreibung"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="#FFFFFF" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/screenTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/artikeluebersicht_titel"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="Zählerliste Wareneingang" />

                <TextView
                    android:id="@+id/screenSubtitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/artikeluebersicht_untertitel"
                    android:textColor="#B8C6DF"
                    android:textSize="12sp"
                    tools:text="Bereich: Lager Nord" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/headerMenuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_meta_panel">

                <ImageButton
                    android:id="@+id/filterButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/filter_symbol_beschreibung"
                    android:padding="9dp"
                    android:src="@drawable/ic_menu"
                    app:tint="#FFFFFF" />

            </FrameLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/testmodusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_meta_panel"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/testmodus_hinweis"
            android:textColor="#D9E6FF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Meta-Informationen -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/metaInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#CC142744"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:strokeColor="#33578FCF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stichtag_label"
                            android:textColor="#9CB0DB"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/stichtagTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="30.06.2026" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="#36578ACF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/blattnummer_label"
                            android:textColor="#9CB0DB"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/vorherigesBlattButton"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="@string/vorheriges_blatt_beschreibung"
                                android:padding="2dp"
                                android:src="@android:drawable/ic_media_previous"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:id="@+id/blattnummerTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="BL-014" />

                            <ImageButton
                                android:id="@+id/naechstesBlattButton"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="@string/naechstes_blatt_beschreibung"
                                android:padding="2dp"
                                android:src="@android:drawable/ic_media_next"
                                app:tint="#FFFFFF" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="#36578ACF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/letzte_zaehlung_label"
                            android:textColor="#9CB0DB"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/letztesZaehldatumTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/artikeluebersicht_letzte_zaehlung_standard"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="28.04.2026" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#36578ACF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bereich_label"
                            android:textColor="#9CB0DB"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/bereichTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Lager Nord" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="#36578ACF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fortschritt_label"
                            android:textColor="#9CB0DB"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/fortschrittTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="2 von 3" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ZÃ¤hler / Schreiber -->
        <LinearLayout
            android:id="@+id/navigationsleisteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_meta_panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="36dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zaehler_label"
                        android:textColor="#9CB0DB"
                        android:textSize="10sp" />

                    <EditText
                        android:id="@+id/zaehlerEditText"
                        android:layout_width="143dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:color/transparent"
                        android:inputType="textPersonName"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B8BEDD"
                        android:textSize="19sp"
                        tools:text="Max Mustermann" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/zaehlerVertretungButton"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/zaehler_vertretung_beschreibung"
                    android:padding="1dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#D9E6FF" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_meta_panel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="36dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schreiber_label"
                        android:textColor="#9CB0DB"
                        android:textSize="10sp" />

                    <EditText
                        android:id="@+id/schreiberEditText"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:color/transparent"
                        android:inputType="textPersonName"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#B8BEDD"
                        android:textSize="19sp"
                        tools:text="Erika Beispiel" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/schreiberVertretungButton"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="6dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/schreiber_vertretung_beschreibung"
                    android:padding="1dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#D9E6FF" />

            </FrameLayout>

        </LinearLayout>

        <!-- Artikelliste -->
        <LinearLayout
            android:id="@+id/listContainerLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/listSectionTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/artikel_liste_titel"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/listSectionHintTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="@string/artikel_liste_untertitel"
                android:textColor="#AAB7D1"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/artikelSucheEditText"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_meta_panel"
                android:hint="@string/artikel_suche_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAB7D1"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/artikelTabellenkopfLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_meta_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:text="@string/artikel_tabellenkopf_position"
                    android:textColor="#9CB0DB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="@string/artikel_tabellenkopf_ident"
                    android:textColor="#9CB0DB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_anmerkung"
                    android:textColor="#9CB0DB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_letzte_zaehlmenge"
                    android:textColor="#9CB0DB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_ist"
                    android:textColor="#9CB0DB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_min"
                    android:textColor="#9CB0DB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/artikel_tabellenkopf_zaehl"
                    android:textColor="#9CB0DB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/leerstandTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_horizontal"
                android:text="@string/leere_artikelliste_hinweis"
                android:textColor="#D8DDF3"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/artikelRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="72dp"
                tools:itemCount="3"
                tools:listitem="@layout/item_artikel" />

        </LinearLayout>

    </LinearLayout>

    <!-- Auto-Save-Status -->
    <FrameLayout
        android:id="@+id/speichernButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_login_primary_button"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/speichernIconImageView"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="82dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_save"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/speichernTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/autosave_status_aktiv"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
