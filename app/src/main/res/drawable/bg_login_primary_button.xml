<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#0052CC"
                android:endColor="#0046B5" />

            <stroke
                android:width="1dp"
                android:color="#2F8CFF" />

            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#2484FF"
                android:centerColor="#0F6FEF"
                android:endColor="#0057D9" />

            <stroke
                android:width="1dp"
                android:color="#4DA1FF" />

            <corners android:radius="24dp" />
        </shape>
    </item>

</selector>